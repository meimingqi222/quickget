{
  "manifest_version": 3,
  "name": "QuickGet",
  "version": "0.1.1",
  "description": "Send links to QuickGet with cookies. Chromium browsers only.",
  "key": "",
  "action": {
    "default_title": "QuickGet",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "cookies",
    "activeTab",
    "storage",
    "downloads",
    "notifications"
  ],
  "host_permissions": ["<all_urls>"]
}
